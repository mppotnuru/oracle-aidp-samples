# OCI Data Integration (source) + OCI / AIDP (destination)
# Copy to .env and fill in. Never commit .env.

# OCI config profile from ~/.oci/config (default: OASEFDE)
OCI_CONFIG_PROFILE=OASEFDE
OCI_REGION=us-ashburn-1

# Source OCI-DI workspace to migrate FROM
DI_WORKSPACE_OCID=
COMPARTMENT_OCID=

# Destination AIDP workbench + workspace (only needed for plan / migrate / verify)
AIDP_WORKBENCH_OCID=
AIDP_WORKSPACE_ID=

# Optional AIDP route override — leave unset for GA endpoint
# AIDP_API_VERSION=20260430
# AIDP_ENDPOINT=

# OCI Object Storage namespace for data-asset path translation
# Find with: oci os ns get
OCI_NAMESPACE=

# Default output directory for inventory / plan / migrate / verify artifacts
OCI_DI_AIDP_OUT=./out
